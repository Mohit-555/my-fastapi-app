# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rdpmsdb
POSTGRES_USER=rdpmsuser
POSTGRES_PASSWORD=rdpmsuser123

DATABASE_URL=postgresql+psycopg2://rdpmsuser:rdpmsuser123@localhost:5432/rdpmsdb

# ── Secrets — startup FAILS if missing/placeholder/too-short (#1) ──────────
# Webhook/gateway ingestion key. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=
# JWT signing secret (>= 32 random chars). Same generator as above.
SECRET_KEY=

# SMMS integration key — optional; warning only when SMMS sync is used
SMMS_API_KEY=

# ── CORS (#6) — comma-separated browser origins allowed to call the API ────
# Local dev defaults apply when unset: http://localhost:5173,http://localhost:3000
# Production (Render backend serving the frontends below):
CORS_ALLOW_ORIGINS=http://3.6.93.103,http://3.6.93.103:3001,https://my-fastapi-app-undz.onrender.com

# ── Bootstrap behaviour ─────────────────────────────────────────────────────
# Set to 1 to skip seeding default users/stations on boot (after first setup).
# Leave unset/0 on a fresh database so default accounts are created once.
SKIP_STARTUP_SEEDING=0
